{
  "seed": 42,
  "seeds": [42, 52, 62, 72, 82],
  "checkpoints": [0.10, 0.25, 0.50, 0.75, 1.00],
  "split": {
    "train": 0.70,
    "validation": 0.15,
    "test": 0.15,
    "stratify_by": "final_intensity"
  },
  "esconv": {
    "path": "../../ESConv.json",
    "input_view": "seeker_text",
    "require_complete_outcome": true
  },
  "meisd": {
    "path": "../../mtl-emotion-intensity-sentiment/data/MEISD_text.csv",
    "scalar_intensity_reducer": "max_active_emotion",
    "neutral_intensity": 0
  },
  "transfer": {
    "esconv_da_path": "../data/ESConv_DA_ready.csv",
    "meisd_da_path": "../data/MEISD_DA_ready.csv",
    "esconv_checkpoints_path": "../data/processed/esconv_checkpoints.csv",
    "prepared_dir": "../data/processed/transfer/prepared",
    "augmented_dir": "../data/processed/transfer/augmented",
    "augmentation": {
      "generator": "llama-2-7b-chat-gguf",
      "context_size": 2048,
      "threads": 8,
      "gpu_layers": -1,
      "batch_size": 1024,
      "checkpoint_every": 25,
      "max_tokens": 150,
      "min_compatible_samples": 5,
      "max_aug_per_group": 600
    }
  },
  "source_mtl": {
    "transformer_name": "bert-base-uncased",
    "max_length": 128,
    "batch_size": 16,
    "epochs": 6,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "dropout": 0.4,
    "warmup_ratio": 0.2,
    "focal_gamma": 2.0,
    "emotion_threshold": 0.4,
    "checkpoint_selection": "emotion_intensity_macro_f1",
    "exclude_invalid_generations": true,
    "drop_exact_train_duplicates": true,
    "drop_conflicting_train_texts": true,
    "soft_sharing_lambda": 0.0001,
    "task_weights": {
      "sentiment": 1.0,
      "emotion": 2.0,
      "intensity": 0.7
    },
    "early_stopping_patience": 3,
    "num_workers": 0,
    "device": "auto",
    "output_dir": "../outputs/source_mtl"
  },
  "source_aligned_mtl": {
    "transformer_name": "bert-base-uncased",
    "emotion_names": ["anger", "disgust", "fear", "sadness"],
    "max_length": 128,
    "batch_size": 16,
    "epochs": 8,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "dropout": 0.3,
    "warmup_ratio": 0.1,
    "focal_gamma": 2.0,
    "emotion_threshold": 0.4,
    "checkpoint_selection": "emotion_intensity_macro_f1",
    "exclude_invalid_generations": true,
    "drop_exact_train_duplicates": true,
    "drop_conflicting_train_texts": true,
    "max_synthetic_to_original_ratio": 1.0,
    "soft_sharing_lambda": 0.0001,
    "task_weights": {
      "sentiment": 0.5,
      "emotion": 2.0,
      "intensity": 1.0
    },
    "early_stopping_patience": 3,
    "num_workers": 0,
    "device": "auto",
    "output_dir": "../outputs/source_aligned_mtl"
  },
  "temporal": {
    "transformer_name": "bert-base-uncased",
    "max_length": 128,
    "max_chunks": 32,
    "batch_size": 8,
    "epochs": 10,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "dropout": 0.4,
    "warmup_ratio": 0.1,
    "strategy_hidden_size": 256,
    "early_stopping_patience": 3,
    "num_workers": 0,
    "device": "auto",
    "output_dir": "../outputs/temporal"
  },
  "outcome_ceiling": {
    "architecture": "full",
    "checkpoints_path": "../data/processed/outcome_ceiling/esconv_checkpoints.csv",
    "source_output_dir": "../outputs/source_aligned_mtl",
    "transformer_name": "bert-base-uncased",
    "max_length": 128,
    "max_chunks": 32,
    "batch_size": 4,
    "epochs": 12,
    "learning_rate": 0.00002,
    "encoder_learning_rate": 0.000005,
    "head_learning_rate": 0.00002,
    "weight_decay": 0.01,
    "dropout": 0.3,
    "warmup_ratio": 0.1,
    "metadata_size": 64,
    "strategy_mode": "quantity_timing_order",
    "strategy_hidden_size": 256,
    "use_speaker_features": true,
    "use_trajectory": true,
    "use_strategy": true,
    "use_auxiliary_regression": true,
    "use_joint_pair_head": true,
    "use_emotion_conditioned_heads": true,
    "auxiliary_regression_weight": 0.2,
    "outcome_focal_gamma": 2.0,
    "joint_classification_weight": 1.0,
    "marginal_auxiliary_weight": 0.3,
    "direct_classification_weight": 1.0,
    "ordinal_auxiliary_weight": 0.2,
    "consistency_weight": 0.1,
    "outcome_sampling_strategy": "none",
    "joint_sampling_power": 0.5,
    "joint_sampling_max_ratio": 4.0,
    "evaluate_test": true,
    "freeze_text_encoder_epochs": 2,
    "gradual_unfreeze_layers": [4],
    "early_stopping_patience": 3,
    "num_workers": 0,
    "device": "auto",
    "output_dir": "../outputs/outcome_ceiling"
  },
  "outcome_augmentation": {
    "input_path": "../data/processed/outcome_ceiling/esconv_checkpoints.csv",
    "output_dir": "../data/processed/outcome_augmentation/full_50pct",
    "fraction": 0.5,
    "context_size": 4096,
    "threads": 8,
    "gpu_layers": -1,
    "batch_size": 1024,
    "checkpoint_every": 10,
    "max_prompt_words": 180,
    "max_tokens": 640
  },
  "strategy_analysis": {
    "bootstrap_samples": 1000,
    "output_dir": "../outputs/strategy_analysis"
  },
  "reporting": {
    "output_dir": "../outputs/report"
  },
  "baseline": {
    "min_df": 2,
    "max_features": 50000,
    "ngram_range": [1, 2],
    "class_weight": "balanced",
    "max_iter": 2000
  }
}
